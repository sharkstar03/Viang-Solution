# Sitio estático en Cloudflare (`npm run build:cloudflare` → carpeta `out/`).
# No hace falta ninguna variable para publicar la web: si faltan, el build
# usa lib/content/fallback.ts y el formulario abre WhatsApp en lugar de /api/contact.
#
# Opcionales al construir el export, para hornear filas publicadas de Supabase
# (si la lectura falla, se usa el mismo fallback y el build sigue):
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# El resto de este archivo lo usa solo el servidor Node opcional (Docker).
# Ese servidor no hace falta para viangsolutions.com. El export estático no
# lee SUPABASE_SERVICE_ROLE_KEY, el correo, Turnstile ni ANALYTICS_SALT_SECRET.

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key   # SOLO servidor, jamás en el cliente

# ── Email (notificación de leads) ───────────────────────────
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_app_password
CONTACT_RECIPIENT=gerencia@viangsolutions.com

# ── Cloudflare Turnstile ────────────────────────────────────
TURNSTILE_SECRET_KEY=tu_clave_secreta
NEXT_PUBLIC_TURNSTILE_SITE_KEY=tu_clave_de_sitio

# ── Analítica ───────────────────────────────────────────────
ANALYTICS_SALT_SECRET=cadena_aleatoria_larga

# ── Páginas de error (funcionan aunque la DB caiga) ─────────
NEXT_PUBLIC_CONTACT_PHONE=+50767340816
NEXT_PUBLIC_CONTACT_WHATSAPP=+50767340816

# ── Cloudflare Tunnel (docker compose) ──────────────────────
TUNNEL_TOKEN=token_del_tunnel
