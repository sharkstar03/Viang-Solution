{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3000/"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 512000
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 163840
          }
        ]
      }
    }
  }
}
